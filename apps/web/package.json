{
  "name": "@clipshare/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev:clean": "node -e \"const fs=require('fs'); for (const p of ['.next','.turbo']) fs.rmSync(p,{recursive:true,force:true});\"",
    "dev:reset": "pnpm run dev:clean && pnpm run dev",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:api": "vitest run tests/api",
    "test:api:watch": "vitest tests/api",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:browser": "bash scripts/browser-test.sh",
    "test:browser:ps1": "powershell -ExecutionPolicy Bypass -File scripts/browser-test.ps1",
    "sentry": "sentry"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.42.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-virtuoso": "^4.18.3",
    "swr": "^2.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0",
    "@sentry/cli": "^3.3.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.17",
    "eslint": "9.39.4",
    "eslint-config-next": "16.1.6",
    "postcss": "^8.4.33",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.0",
    "vitest": "^3.0.0"
  }
}
