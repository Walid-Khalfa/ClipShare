# Development Environment Variables
# Copy this file to .env and fill in the values

# ===========================================
# App Configuration
# ===========================================
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# JWT_SECRET: Generate a secure random secret for production using:
#   openssl rand -base64 32
# Do not use default values in production - this will cause authentication failures
JWT_SECRET=

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=recordings

# ===========================================
# CDN Configuration
# ===========================================
# CDN URL for video delivery
# Options:
# - Supabase built-in CDN (default): Leave empty or use Supabase storage URL
# - CloudFront: https://your-cloudfront-distribution.cloudfront.net
# - Custom CDN: https://cdn.yourdomain.com
NEXT_PUBLIC_CDN_URL=

# ===========================================
# Logging
# ===========================================
# Log level: trace, debug, info, warn, error, fatal
# Development: debug or info
# Production: info or warn
LOG_LEVEL=info

# ===========================================
# Sentry (Error Tracking & Performance Monitoring)
# ===========================================
# Get your DSN from Sentry project settings
# Format: https://<key>@sentry.io/<project_id>
NEXT_PUBLIC_SENTRY_DSN=

# Environment: development, staging, production
SENTRY_ENVIRONMENT=development

# Sample rates (0.0 to 1.0)
# Traces: Percentage of transactions to capture for performance monitoring
SENTRY_TRACES_SAMPLE_RATE=1.0

# Errors: Percentage of errors to capture
SENTRY_ERROR_SAMPLE_RATE=1.0

# Optional: Sentry organization and project (for Vercel integration)
SENTRY_ORG=
SENTRY_PROJECT=

# ===========================================
# Rate Limiting
# ===========================================
# Rate limit cleanup is handled by the cleanup:rate-limits script
# Run via cron: 0 2 * * * pnpm --filter @clipshare/api run cleanup:rate-limits
