# Production Environment Variables
# Copy this file to .env.production and fill in the values
# IMPORTANT: Never commit .env.production to version control

# ===========================================
# App Configuration
# ===========================================
# The production URL of your application (e.g., https://clipshare.example.com)
APP_URL=https://your-domain.vercel.app

# CORS origin for production (your exact domain)
CORS_ORIGIN=https://your-domain.vercel.app

# ===========================================
# Supabase
# ===========================================
# Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key (safe to expose in client code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key - MUST be protected server-side only
# Use this only in server-side code, never expose to client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name
SUPABASE_STORAGE_BUCKET=recordings

# ===========================================
# Rate Limiting (Optional)
# ===========================================
# Secret for rate limiting IP hashing
RATE_LIMIT_SECRET=your-secure-random-string-at-least-32-chars

# ===========================================
# Security
# ===========================================
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your-secure-jwt-secret-min-32-chars
